---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<img class="hero-bg" src="/images/sky-hero.png" alt="" />
				<div class="hero-overlay">
					<div class="hero-copy">
						<p class="eyebrow">{SITE_TITLE} / {SITE_AUTHOR}</p>
						<h1>HanHao</h1>
						<p class="intro">{SITE_DESCRIPTION}</p>
						<div class="hero-actions">
							<a class="primary-action" href="/blog">Read Articles</a>
							<a class="secondary-action" href="/projects">View Projects</a>
						</div>
					</div>
				</div>
			</section>
			<section class="quick-links" aria-label="Site sections">
				<a href="/blog">
					<span>Articles</span>
					写点技术、折腾和日常记录。
				</a>
				<a href="/projects">
					<span>Projects</span>
					放一些做过、正在做、想做的东西。
				</a>
				<a href="/other">
					<span>Other</span>
					随便放点别的，先给未来留个位置。
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell {
		width: min(1120px, calc(100% - 2em));
		padding-top: 2em;
	}
	.hero {
		position: relative;
		overflow: hidden;
		min-height: 620px;
		border: 1px solid rgba(255, 255, 255, 72%);
		border-radius: 8px;
		box-shadow: 0 28px 80px rgba(54, 128, 184, 20%);
		background: #dff5ff;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 92%) 0%, rgba(255, 255, 255, 74%) 42%, rgba(255, 255, 255, 8%) 100%),
			linear-gradient(0deg, rgba(15, 75, 116, 22%) 0%, rgba(15, 75, 116, 0%) 48%);
	}
	.hero-copy {
		width: min(620px, calc(100% - 3rem));
		padding: 4rem;
	}
	.eyebrow {
		margin: 0 0 1em;
		color: #2689c9;
		font-size: 0.85em;
		font-weight: 700;
		text-transform: uppercase;
	}
	.hero h1 {
		margin: 0;
		color: #0d3b66;
		font-size: 7.5rem;
		line-height: 0.95;
		letter-spacing: 0;
	}
	.intro {
		max-width: 520px;
		margin: 1.2em 0 0;
		color: #315d7b;
		font-size: 1.35em;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8em;
		margin-top: 2em;
	}
	.hero-actions a {
		border-radius: 8px;
		padding: 0.75em 1.1em;
		font-size: 0.9em;
		font-weight: 700;
		text-decoration: none;
	}
	.primary-action {
		background: #1a9de1;
		color: white;
		box-shadow: 0 16px 30px rgba(26, 157, 225, 25%);
	}
	.secondary-action {
		background: rgba(255, 255, 255, 70%);
		color: #146b9d;
		border: 1px solid rgba(30, 144, 207, 24%);
	}
	.quick-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1em;
		margin: 1em 0 4em;
	}
	.quick-links a {
		min-height: 118px;
		border: 1px solid rgba(91, 179, 232, 22%);
		border-radius: 8px;
		padding: 1.1em;
		background: rgba(255, 255, 255, 72%);
		box-shadow: 0 18px 45px rgba(89, 158, 210, 12%);
		color: #45697f;
		text-decoration: none;
	}
	.quick-links span {
		display: block;
		margin-bottom: 0.45em;
		color: #0d3b66;
		font-size: 1.15em;
		font-weight: 800;
	}
	@media (max-width: 820px) {
		.hero {
			min-height: 520px;
		}
		.hero-overlay {
			background: linear-gradient(0deg, rgba(255, 255, 255, 92%) 0%, rgba(255, 255, 255, 62%) 70%, rgba(255, 255, 255, 16%) 100%);
		}
		.hero-copy {
			width: calc(100% - 2rem);
			padding: 1.5rem;
		}
		.hero h1 {
			font-size: 4.25rem;
		}
		.quick-links {
			grid-template-columns: 1fr;
		}
	}
</style>
