---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">{SITE_TITLE} / {SITE_AUTHOR}</p>
					<h1>HanHao</h1>
					<p class="intro">{SITE_DESCRIPTION}</p>
					<div class="hero-actions">
						<a class="primary-action" href="/blog">Read Articles</a>
						<a class="secondary-action" href="/projects">View Projects</a>
					</div>
				</div>
				<div class="hero-image" aria-hidden="true">
					<img src="/images/sky-hero.png" alt="" />
				</div>
			</section>
			<section class="quick-links" aria-label="Site sections">
				<a href="/blog">
					<span>Articles</span>
					写点技术、折腾和日常记录。
				</a>
				<a href="/projects">
					<span>Projects</span>
					放一些做过、正在做、想做的东西。
				</a>
				<a href="/other">
					<span>Other</span>
					随便放点别的，先给未来留个位置。
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell {
		width: min(1120px, calc(100% - 2em));
		padding-top: 4em;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
		align-items: center;
		gap: 3rem;
		min-height: 560px;
	}
	.eyebrow {
		margin: 0 0 1em;
		color: #2689c9;
		font-size: 0.85em;
		font-weight: 700;
		text-transform: uppercase;
	}
	.hero h1 {
		margin: 0;
		color: #0d3b66;
		font-size: clamp(4rem, 9vw, 8.5rem);
		line-height: 0.92;
	}
	.intro {
		max-width: 520px;
		margin: 1.4em 0 0;
		color: #315d7b;
		font-size: 1.35em;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8em;
		margin-top: 2em;
	}
	.hero-actions a {
		border-radius: 999px;
		padding: 0.75em 1.1em;
		font-size: 0.9em;
		font-weight: 700;
		text-decoration: none;
	}
	.primary-action {
		background: #1a9de1;
		color: white;
		box-shadow: 0 16px 30px rgba(26, 157, 225, 25%);
	}
	.secondary-action {
		background: rgba(255, 255, 255, 70%);
		color: #146b9d;
		border: 1px solid rgba(30, 144, 207, 24%);
	}
	.hero-image {
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 72%);
		border-radius: 28px;
		box-shadow: 0 28px 80px rgba(54, 128, 184, 22%);
	}
	.hero-image img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}
	.quick-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1em;
		margin: 1.5em 0 4em;
	}
	.quick-links a {
		min-height: 118px;
		border: 1px solid rgba(91, 179, 232, 22%);
		border-radius: 20px;
		padding: 1.1em;
		background: rgba(255, 255, 255, 72%);
		box-shadow: 0 18px 45px rgba(89, 158, 210, 12%);
		color: #45697f;
		text-decoration: none;
	}
	.quick-links span {
		display: block;
		margin-bottom: 0.45em;
		color: #0d3b66;
		font-size: 1.15em;
		font-weight: 800;
	}
	@media (max-width: 820px) {
		.home-shell {
			padding-top: 2em;
		}
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}
		.quick-links {
			grid-template-columns: 1fr;
		}
	}
</style>
