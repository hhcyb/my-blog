---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Articles | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1040px, calc(100% - 2em));
				padding-top: 3em;
			}
			.page-intro {
				margin-bottom: 2em;
				padding: 2em;
				border: 1px solid rgba(91, 179, 232, 22%);
				border-radius: 8px;
				background:
					linear-gradient(135deg, rgba(255, 255, 255, 88%), rgba(220, 245, 255, 70%)),
					url('/images/sky-hero.png') center / cover;
				box-shadow: 0 18px 55px rgba(89, 158, 210, 14%);
			}
			.page-intro p {
				max-width: 620px;
				margin: 0;
				color: #426d86;
			}
			.page-intro h1 {
				margin: 0 0 0.35em;
				color: #0d3b66;
				font-size: 3.2rem;
				letter-spacing: 0;
			}
			.article-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.article-card {
				min-height: 220px;
			}
			.article-card a {
				display: flex;
				flex-direction: column;
				height: 100%;
				border: 1px solid rgba(91, 179, 232, 22%);
				border-radius: 8px;
				padding: 1.2em;
				background: rgba(255, 255, 255, 76%);
				box-shadow: 0 18px 45px rgba(89, 158, 210, 12%);
				color: #315d7b;
				text-decoration: none;
				transition:
					transform 0.18s ease,
					box-shadow 0.18s ease,
					border-color 0.18s ease;
			}
			.article-card a:hover {
				transform: translateY(-3px);
				border-color: rgba(26, 157, 225, 42%);
				box-shadow: 0 22px 60px rgba(89, 158, 210, 18%);
			}
			.article-card h2 {
				margin: 0 0 0.55em;
				color: #0d3b66;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			.article-card p {
				margin: 0;
			}
			.date {
				margin-top: auto;
				padding-top: 1.4em;
				color: #2689c9;
				font-size: 0.86em;
				font-weight: 700;
			}
			@media (max-width: 720px) {
				main {
					padding-top: 1.25em;
				}
				.page-intro {
					padding: 1.25em;
				}
				.page-intro h1 {
					font-size: 2.25rem;
				}
				.article-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-intro">
				<h1>Articles</h1>
				<p>写点技术、折腾、学习和日常。先把想法放下来，后面再慢慢打磨。</p>
			</section>
			<ul class="article-list">
				{
					posts.map((post) => (
						<li class="article-card">
							<a href={`/blog/${post.id}/`}>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
