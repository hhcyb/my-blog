---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_AUTHOR} / {SITE_TITLE}.
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
