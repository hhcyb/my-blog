---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/other">Other</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.25em;
		background: rgba(255, 255, 255, 82%);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid rgba(83, 177, 236, 18%);
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		letter-spacing: 0;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 72px;
		max-width: 1120px;
		margin: 0 auto;
	}
	nav a {
		padding: 0.8em 0.7em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.45em;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.75em;
		}
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25em;
			padding: 0.8em 0;
		}
		nav a {
			padding: 0.35em 0.45em;
		}
		.internal-links {
			flex-wrap: wrap;
		}
	}
</style>
